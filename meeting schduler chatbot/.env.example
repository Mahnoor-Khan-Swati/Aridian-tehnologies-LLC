# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file or share your API key in chat/screenshots.

# Cal.com API key (required) - Cal.com dashboard > Settings > Developer > API Keys
CAL_API_KEY= ....

# --- Optional (defaults are usually fine) ---
CAL_BASE_URL=https://api.cal.com/v2
CAL_EVENT_TYPE_ID=6671003
TIMEZONE=Asia/Karachi
MEETING_TITLE=Quick Meeting
