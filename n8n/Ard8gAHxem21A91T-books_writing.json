        96
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=\"I am writing a book titled:{{ $item(0).$node[\"Google Sheets Trigger\"].json[\"title\"] }}\n\nCurrent Task: > Write the full content for Chapter {{ $json.chapter_number }}: {{ $json.chapter_title }}.\n\nChapter Goal: > {{ $json.chapter_description }}\n\nWriting Requirements:\n\nLength: Approximately 800-1000 words.\n\nUse clear headings where appropriate.\n\nEnsure the content is accurate and engaging.\n\nAt the very end of your response, provide a 2-sentence summary of this chapter for my records, starting with the label 'SUMMARY:'\"",
        "options": {
          "systemMessage": "You are an expert non-fiction book author. Your goal is to write high-quality, educational, and engaging book chapters. Write in a clear, professional tone suitable for beginners. Do not repeat the chapter title in the body text."
        }
