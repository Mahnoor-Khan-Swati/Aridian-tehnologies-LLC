    {
      "parameters": {
        "jsCode": "// We define the output array\nconst output = [];\n\n// We loop through every \"item\" (book) coming into the node\nfor (const item of $input.all()) {\n    const outline = item.json.outline;\n    const bookId = item.json.id;\n\n    // The Regex to find chapters\n    const regex = /Chapter\\s+(\\d+):\\s+([^\\n-]+)(?:[\\s-]+)?([\\s\\S]*?)(?=Chapter\\s+\\d+:|$)/g;\n    let match;\n\n    while ((match = regex.exec(outline)) !== null) {\n        output.push({\n            json: {\n                chapter_number: parseInt(match[1]),\n                chapter_title: match[2].trim(),\n                chapter_description: match[3].trim(),\n                book_id: bookId\n            }\n        });\n    }\n}\n\nreturn output;"
      },
      "id": "d3bc9526-7ad2-4d19-ba9e-cef73fa24343",
      "name": "cleaner",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
