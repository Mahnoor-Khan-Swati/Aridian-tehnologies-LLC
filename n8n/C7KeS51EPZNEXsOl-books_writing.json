    {
      "parameters": {
        "promptType": "define",
        "text": "=\"You are an expert book architect. Title: {{ $('Google Sheets Trigger').item.json.title }}  Instructions:{{ $('Google Sheets Trigger').item.json.notes_on_outline_before }} . Generate a 10-chapter outline. Format: Chapter [Number]: [Title] - [2 sentence summary].\"",
        "options": {
          "systemMessage": "=\"You are an expert book architect. Title: {{ $('Google Sheets Trigger').item.json.title }}  Instructions:{{ $('Google Sheets Trigger').item.json.notes_on_outline_before }} . Generate a 10-chapter outline. Format: Chapter [Number]: [Title] - [2 sentence summary].\""
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        624,
        0
      ],
      "id": "bf2cdab9-17f0-40c2-bb82-3cb6d4a6baca",
      "name": "outline content"
    },
    {
      "parameters": {
        "jsCode": "const output = [];\n\n// Get generated outline directly from the AI node\nconst aiOutline = $('outline content').first().json.output;\n\n// Get current book information\nconst bookData = $('Google Sheets Trigger').first().json;\n\nconst outline = aiOutline;\nconst bookId = $('Create a row').first().json.id || '';\nconst bookTitle = bookData.title || '';\n\n// Check outline\nif (!outline || typeof outline !== 'string') {\n    throw new Error('The outline content node did not return an outline.');\n}\n\n// Remove Markdown formatting\nconst cleanedOutline = outline\n    .replace(/\\*\\*/g, '')\n    .replace(/__/g, '')\n    .replace(/\\r\\n/g, '\\n')\n    .replace(/\\r/g, '\\n')\n    .trim();\n\n// Find each chapter\nconst regex =\n    /Chapter\\s*(\\d+)\\s*:\\s*(.*?)\\s*-\\s*([\\s\\S]*?)(?=Chapter\\s*\\d+\\s*:|$)/gi;\n\nlet match;\n\nwhile ((match = regex.exec(cleanedOutline)) !== null) {\n\n    output.push({\n        json: {\n            book_id: bookId,\n            book_title: bookTitle,\n            chapter_number: Number(match[1]),\n            chapter_title: match[2].trim(),\n            chapter_description: match[3].trim()\n        }\n    });\n}\n\nif (output.length === 0) {\n    throw new Error(\n        'Outline exists, but chapters could not be detected. Check the outline format.'\n    );\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1504,
        32
      ],
      "id": "61d5b596-ab7b-4355-8146-4a112a1b091b",
      "name": "cleaner"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=\"I am writing a book titled:{{ $item(0).$node[\"Google Sheets Trigger\"].json[\"title\"] }}\n\nCurrent Task: > Write the full content for Chapter {{ $json.chapter_number }}: {{ $json.chapter_title }}.\n\nChapter Goal: > {{ $json.chapter_description }}\n\nWriting Requirements:\n\nLength: Approximately 800-1000 words.\n\nUse clear headings where appropriate.\n\nEnsure the content is accurate and engaging.\n\nAt the very end of your response, provide a 2-sentence summary of this chapter for my records, starting with the label 'SUMMARY:'\"",
        "options": {
          "systemMessage": "You are an expert non-fiction book author. Your goal is to write high-quality, educational, and engaging book chapters. Write in a clear, professional tone suitable for beginners. Do not repeat the chapter title in the body text."
        }
      },
