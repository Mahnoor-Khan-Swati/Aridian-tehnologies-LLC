      "parameters": {
        "jsCode": "const outline = $input.first().json.output;\n\nconst chapters = [];\nconst regex = /Chapter\\s+(\\d+):\\s*([^-]+?)\\s*-\\s*([\\s\\S]*?)(?=\\s*Chapter\\s+\\d+:|$)/gi;\n\nlet match;\n\nwhile ((match = regex.exec(outline)) !== null) {\n  chapters.push({\n    json: {\n      chapter_number: Number(match[1]),\n      chapter_title: match[2].trim(),\n      chapter_description: match[3].trim()\n    }\n  });\n}\n\nreturn chapters;"
      },
